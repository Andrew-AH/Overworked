<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Overworked.App.ViewModels"
        xmlns:views="using:Overworked.App.Views"
        x:Class="Overworked.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Overworked"
        Icon="/Assets/overworked.ico"
        Width="420" Height="660" MinWidth="360" MaxWidth="560" MinHeight="320"
        ExtendClientAreaToDecorationsHint="True">

  <Window.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Rectangle.rail">
      <Setter Property="Width" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.add">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.row:pointerover Button.add, Button.add:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Path.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Path.chevron.collapsed">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- title bar with the mark; the OS treats it as the real title bar (see constructor) -->
    <Panel x:Name="TitleBar" DockPanel.Dock="Top" Height="38" Background="Transparent">
      <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Source="/Assets/logo-64.png" Width="24" Height="24" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Overworked" FontFamily="{StaticResource Mono}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- summary + folder + refresh -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="24,6,24,12" MaxWidth="864">
      <TextBlock FontSize="13" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding SummaryCount}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" /><Run Text="{Binding SummaryRest}" />
      </TextBlock>
      <Button Grid.Column="1" Classes="icon" Click="ChooseRoot_Click" IsVisible="{Binding HasRoot}" ToolTip.Tip="{Binding RootTip}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="M 1,3.5 L 1,11 L 13,11 L 13,4.5 L 6.5,4.5 L 5,2.5 L 1,2.5 Z" Width="14" Height="13" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RootName}" Classes="mono" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="icon" Click="Refresh_Click" IsVisible="{Binding HasRoot}" ToolTip.Tip="Refresh">
        <Path Data="M 12,7 A 5,5 0 1 1 10.5,3.4 M 11,0.8 L 11,3.8 L 8,3.8" Width="14" Height="14" />
      </Button>
    </Grid>

    <!-- status -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hairline}"
            Padding="24,10" IsVisible="{Binding Status.IsVisible}">
      <TextBlock Text="{Binding Status.Text}" Classes.danger="{Binding Status.IsError}" FontSize="12" TextWrapping="Wrap" MaxWidth="864" />
    </Border>

    <Panel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRoot}">
        <!-- a centred column: on a wide or maximised window the rows stay readable instead of stretching edge to edge -->
        <ItemsControl x:Name="RepoList" ItemsSource="{Binding Rows}" Margin="16,0,16,16" MaxWidth="880">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RepoRow">
              <StackPanel Margin="0,0,0,8">

                <!-- repo: right-click opens RepoMenu (branch search + actions) -->
                <Border Classes="row" ContextRequested="RepoRow_ContextRequested">
                  <Grid ColumnDefinitions="28,*,Auto,Auto,Auto">
                    <Panel>
                      <!-- the lane's line pulses with its worktrees; the repo's own dot stays steady -->
                      <views:Pulse>
                        <Rectangle Classes="rail" Fill="{Binding Lane}" Margin="11.25,17,0,0" IsVisible="{Binding ShowsRail}" />
                      </views:Pulse>
                      <Ellipse Width="10" Height="10" Fill="{Binding Lane}" Margin="7,12,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasWorktrees}" />
                      <!-- idle repos stay grey so the ones in flight stand out -->
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Muted}" Opacity="0.55" Margin="9,14,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding !HasWorktrees}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="0,7,0,8" Spacing="1">
                      <TextBlock Text="{Binding Name}" Classes="reponame" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                      <TextBlock Text="{Binding Detail}" Classes="mono" Classes.danger="{Binding IsBroken}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                      <TextBlock Text="{Binding ChangesText}" Classes="mono dirty" Margin="8,10,0,0" IsVisible="{Binding IsDirty}" />
                      <Button Classes="tag ticket" Content="{Binding TicketKey}" Background="{Binding TicketColour}" ToolTip.Tip="{Binding TicketUrl}"
                              Click="OpenTicket_Click" Margin="8,6,0,0" VerticalAlignment="Top" IsVisible="{Binding HasTicket}" />
                      <Button Classes="tag pr" Content="{Binding PullRequestText}" ToolTip.Tip="{Binding PullRequestUrl}" Click="OpenPullRequest_Click"
                              Margin="8,6,0,0" VerticalAlignment="Top" IsVisible="{Binding HasPullRequest}" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="icon add" Click="NewWorktree_Click" ToolTip.Tip="New worktree"
                            VerticalAlignment="Top" Margin="2,5,4,0">
                      <Path Data="M 6,1 L 6,11 M 1,6 L 11,6" Width="12" Height="12" />
                    </Button>
                    <Button Grid.Column="4" Classes="icon" Click="Toggle_Click" IsVisible="{Binding HasWorktrees}"
                            VerticalAlignment="Top" Margin="0,5,4,0" ToolTip.Tip="Show or hide worktrees">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Worktrees.Count}" Classes="mono" Foreground="{Binding $parent[Button].Foreground}"
                                   VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
                        <Path Classes="chevron" Classes.collapsed="{Binding !IsExpanded}" Data="M 1.5,4 L 6,8.5 L 10.5,4" Width="12" Height="12" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>

                <!-- its worktrees, drawn as branches off the repo's lane -->
                <ItemsControl ItemsSource="{Binding Worktrees}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorktreeRow">
                      <Border Classes="row">
                        <Border.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Open in VS Code" Click="OpenInCode_Click" />
                            <MenuItem Header="Open folder" Click="OpenFolder_Click" />
                            <MenuItem Header="Open terminal" Click="OpenTerminal_Click" />
                            <MenuItem Header="Copy branch name" Click="CopyBranch_Click" IsVisible="{Binding HasBranch}" />
                            <MenuItem Header="Tag ticket…" Click="TagTicket_Click" IsVisible="{Binding HasBranch}" />
                            <MenuItem Header="Tag pull request…" Click="TagPullRequest_Click" IsVisible="{Binding HasBranch}" />
                            <Separator />
                            <MenuItem Header="Remove worktree…" Click="RemoveWorktree_Click" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="54,*,Auto">
                          <Panel>
                            <views:Pulse>
                              <Rectangle Classes="rail" Fill="{Binding Lane}" Margin="11.25,0,0,0" IsVisible="{Binding !IsLast}" />
                              <Border Width="22" Height="17" Margin="11.25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      BorderBrush="{Binding Lane}" BorderThickness="1.5,0,0,1.5" CornerRadius="0,0,0,7" />
                              <Ellipse Width="9" Height="9" Margin="33,11.75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Fill="{Binding Lane}" Stroke="{Binding Lane}" StrokeThickness="1.5" IsVisible="{Binding !IsMissing}" />
                            </views:Pulse>
                            <Ellipse Width="9" Height="9" Margin="33,11.75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Stroke="{DynamicResource Danger}" StrokeThickness="1.5" StrokeDashArray="1.5,1.5"
                                     IsVisible="{Binding IsMissing}" />
                          </Panel>
                          <StackPanel Grid.Column="1" Margin="0,7,0,8" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Classes="mono" Classes.danger="{Binding IsBroken}"
                                       IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ChangesText}" Classes="mono dirty" Margin="8,10,0,0" IsVisible="{Binding IsDirty}" />
                            <Button Classes="tag ticket" Content="{Binding TicketKey}" Background="{Binding TicketColour}" ToolTip.Tip="{Binding TicketUrl}"
                                    Click="OpenTicket_Click" Margin="8,5,0,0" VerticalAlignment="Top" IsVisible="{Binding HasTicket}" />
                            <Button Classes="tag pr" Content="{Binding PullRequestText}" ToolTip.Tip="{Binding PullRequestUrl}" Click="OpenPullRequest_Click"
                                    Margin="8,5,0,0" VerticalAlignment="Top" IsVisible="{Binding HasPullRequest}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- no folder chosen yet -->
      <StackPanel IsVisible="{Binding !HasRoot}" Spacing="10" MaxWidth="280"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="/Assets/logo-256.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,8"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Choose your repos folder" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Every repo inside it shows up here, with the worktrees you've made from it." />
        <Button Content="Choose folder" Classes="primary" HorizontalAlignment="Center" Margin="0,6,0,0" Click="ChooseRoot_Click" />
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
